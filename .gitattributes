# All text files use LF in the repository
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.vsix binary
*.pb binary
*.icns binary

# Windows batch scripts require CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell scripts require CRLF for Windows PowerShell parser
*.ps1 text eol=crlf

# Source / docs / configs — LF
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
