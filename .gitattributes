# Все текстовые файлы — LF в репозитории
* text=auto eol=lf

# Специфичные типы файлов, которые должны оставаться как есть (бинарные)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Windows-скрипты — CRLF (требование Windows)
*.cmd text eol=crlf
*.bat text eol=crlf

# Python-код — LF
*.py text eol=lf

# JavaScript/TypeScript — LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf

# Docker и конфиги — LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sql text eol=lf

# HTML/CSS — LF
*.html text eol=lf
*.css text eol=lf
