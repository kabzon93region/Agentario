{
	"mcpServers": {
		"memory": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "@modelcontextprotocol/server-memory"]
			},
			"disabled": true,
			"autoApprove": ["create_entities", "create_relations", "add_observations", "search_nodes", "open_nodes"]
		},
		"memory-slim": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "memory-slim@latest"]
			},
			"disabled": true
		},
		"sequential-thinking": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
			},
			"disabled": false
		},
		"sequential-thinking-slim": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "sequential-thinking-slim@latest"]
			},
			"disabled": true
		},
		"context7": {
			"transport": {
				"type": "streamableHttp",
				"url": "https://mcp.context7.com/mcp"
			},
			"disabled": false
		},
		"charlotte": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "@ticktockbent/charlotte"]
			},
			"disabled": true
		},
		"playwright": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "@playwright/mcp@latest"]
			},
			"disabled": true
		},
		"trueline": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "trueline-mcp@latest"]
			},
			"disabled": true,
			"autoApprove": [
				"trueline_read",
				"trueline_outline",
				"trueline_search",
				"trueline_verify",
				"trueline_changes",
				"trueline_edit"
			]
		},
		"github": {
			"transport": {
				"type": "stdio",
				"command": "npx",
				"args": ["-y", "@modelcontextprotocol/server-github"]
			},
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_TOKEN>"
			},
			"disabled": true
		}
	}
}
